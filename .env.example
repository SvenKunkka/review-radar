# =============================================================================
# Product Review Radar — Environment Variables
# Copy this to .env and fill in your keys before running.
# =============================================================================

# --- Reddit (optional) ---
# Leave blank to use the unauthenticated public JSON API (rate-limited but works).
# Get credentials at: https://www.reddit.com/prefs/apps
MAIN_VITE_REDDIT_CLIENT_ID=
MAIN_VITE_REDDIT_CLIENT_SECRET=

# --- YouTube Data API v3 ---
# Get key at: https://console.cloud.google.com → APIs & Services → YouTube Data API v3
MAIN_VITE_YOUTUBE_API_KEY=

# --- Anthropic (Claude) ---
# Get key at: https://console.anthropic.com
MAIN_VITE_ANTHROPIC_API_KEY=

# --- LLM Provider ---
# Options: ollama | anthropic | mock
# ollama = free, runs locally (recommended, no API key needed)
# anthropic = Claude API (paid, requires MAIN_VITE_ANTHROPIC_API_KEY)
# mock = keyword heuristics only, no AI
MAIN_VITE_LLM_PROVIDER=ollama

# --- Ollama (local, free) ---
# Install: https://ollama.com
# Pull a model first: ollama pull llama3.2
# Recommended models (pick one):
#   llama3.2        — fast, 2 GB, good quality  ← default
#   llama3.1:8b     — slower, 4.7 GB, higher quality
#   mistral         — fast, 4 GB, good at structured JSON
#   qwen2.5:7b      — excellent JSON adherence
MAIN_VITE_OLLAMA_BASE_URL=http://localhost:11434
MAIN_VITE_OLLAMA_MODEL=llama3.2

# --- Collection settings ---
MAIN_VITE_DEFAULT_MAX_RESULTS=50

# --- Cache ---
MAIN_VITE_CACHE_ENABLED=true
MAIN_VITE_CACHE_TTL=3600

# --- Enabled sources (comma-separated) ---
# Options: reddit,youtube,trustpilot
MAIN_VITE_ENABLED_SOURCES=reddit,youtube,trustpilot
